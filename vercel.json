{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/profile", "destination": "/profile/", "permanent": false },
    { "source": "/bni", "destination": "/bni/", "permanent": false },
    { "source": "/stephen-bni", "destination": "/bni/", "permanent": false },
    { "source": "/stephen-bni/", "destination": "/bni/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/profile/", "destination": "/stephen/index.html" },
    { "source": "/profile/:path*", "destination": "/stephen/:path*" },
    { "source": "/bni/", "destination": "/stephen-bni/index.html" },
    { "source": "/bni/:path*", "destination": "/stephen-bni/:path*" }
  ],
  "headers": [
    {
      "source": "/:card/data.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/:card/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    }
  ]
}
